# ---------------------------------------------------------------------------
# Study Planner with Human-in-the-Loop — local configuration
# Copy to .env and fill in. Everything with a default works out of the box
# for a fully local run except PROJECT_ENDPOINT (unless FAKE_AGENT=true).
# ---------------------------------------------------------------------------

# --- Azure AI Foundry (Agent Service) ---------------------------------------
# Foundry project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
PROJECT_ENDPOINT=
MODEL_DEPLOYMENT_NAME=gpt-4o
# Reuse an existing agent instead of creating one on startup (optional).
AGENT_ID=
# Skip Foundry entirely and return a canned study guide (local dev / CI).
FAKE_AGENT=true

# --- State store (Azure Table Storage) ------------------------------------
# Table endpoint, e.g. https://<account>.table.core.windows.net
# Leave blank locally to use an in-memory table repo.
STORAGE_TABLE_ENDPOINT=

# --- Approval e-mail (Azure Communication Services) ----------------------
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=DoNotReply@example.azurecomm.net
# Print e-mails to the server console instead of sending them.
DEV_EMAIL_TO_CONSOLE=true

# --- Approval workflow ---------------------------------------------------
# Random secret used to sign Approve/Reject links (HMAC). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APPROVAL_SIGNING_KEY=change-me-in-production
# Public base URL the boss's browser can reach (no trailing slash).
PUBLIC_BASE_URL=http://localhost:8000
# Hours an Approve/Reject link stays valid.
APPROVAL_LINK_TTL_HOURS=72
# Fallback approver when a learner is not in APPROVERS_JSON.
DEFAULT_APPROVER_EMAIL=boss@example.com
# Per-learner boss mapping: {"learner@contoso.com": "manager@contoso.com"}
APPROVERS_JSON={}

# --- Learner identity (local dev only) ---------------------------------
# In Azure this comes from App Service Easy Auth headers.
DEV_USER_EMAIL=learner@example.com
DEV_USER_NAME=Demo Learner

# --- Microsoft Learn Catalog API -------------------------------------
LEARN_CATALOG_URL=https://learn.microsoft.com/api/catalog/
LEARN_CATALOG_TTL_HOURS=6
